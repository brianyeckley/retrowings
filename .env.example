# Copy to `.env` next to docker-compose.yml and fill in. `.env` is gitignored.

# Cloudflare Tunnel token for the `tunnel` service
# (Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> install command).
TUNNEL_TOKEN=

# Host port for playing on your LAN without the tunnel.
PORT=4100

# Only for the optional watchtower profile with a private image:
# path to the docker credentials file created by `docker login ghcr.io`.
# DOCKER_CONFIG_JSON=/home/youruser/.docker/config.json
